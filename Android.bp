// SPDX-License-Identifier: Apache-2.0
package { default_applicable_licenses: ["diamaneos_emergency_location_license"] }
license {
    name: "diamaneos_emergency_location_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}
// SPDX-License-Identifier: Apache-2.0
android_app {
    name: "DiamaneOSEmergencyLocation",
    srcs: ["src/**/*.java"], resource_dirs: ["res"],
    sdk_version: "system_current", privileged: true, system_ext_specific: true,
    required: ["privapp-permissions-org.diamaneos.emergencylocation.xml",
        "default-permissions-emergency-location.xml", "sysconfig-emergency-location.xml"],
    // No default product selection until endpoint/permission/policy qualification.
}
